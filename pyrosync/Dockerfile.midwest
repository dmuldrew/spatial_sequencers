FROM python:3.12-slim-bookworm

ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1     && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir rasterio==1.4.4 'h3==4.3.1' 'tifffile==2026.3.3' \
    && case "$TARGETARCH" in arm64) wheel_arch=aarch64 ;; amd64) wheel_arch=x86_64 ;; *) exit 1 ;; esac \
    && python -m pip install --no-cache-dir --no-deps \
      "https://github.com/dmuldrew/raster_h3/releases/download/v0.7.0/raster_h3-0.7.0-py3-none-manylinux_2_28_${wheel_arch}.whl"

WORKDIR /app
COPY scripts/prepare_midwest_blocks.py scripts/midwest_archive.py scripts/midwest_service.py scripts/fire_context.py ./
ENV MIDWEST_CACHE=/cache
EXPOSE 3001
CMD ["python", "-u", "midwest_service.py"]
